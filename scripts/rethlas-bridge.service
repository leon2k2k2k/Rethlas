[Unit]
Description=Moon Bridge (Responses->DeepSeek translation proxy for codex)
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/moon-bridge
ExecStart=/path/to/moon-bridge/moonbridge --config /path/to/moon-bridge/config.yml
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
