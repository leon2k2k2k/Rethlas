[Unit]
Description=Rethlas Workbench (FastAPI dashboard)
After=network.target

[Service]
Type=simple
User=claude-user
WorkingDirectory=/home/claude-user/rethlas/ui
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
